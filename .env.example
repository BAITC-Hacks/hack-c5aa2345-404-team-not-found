# Application
APP_NAME=HackAlem Meeting Protocol API
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Local storage — never commit recordings or resulting transcripts.
MEETINGS_STORAGE_PATH=./data/meetings
DELETE_SOURCE_AFTER_PROCESSING=false

# Planned local-model configuration. Nothing is downloaded or loaded now.
WHISPER_MODEL_NAME=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
PYANNOTE_MODEL_NAME=pyannote/speaker-diarization-community-1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3

# Set only in an approved local deployment environment.
# HUGGINGFACE_TOKEN=
