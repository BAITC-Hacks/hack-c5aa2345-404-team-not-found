# Reference only: set environment variables in PowerShell; .env is not read automatically.
APP_NAME=SAMRUK KAZYNA Meeting Protocol API
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Local storage — never commit recordings or resulting transcripts.
# Default is %LOCALAPPDATA%/SAMRUK_KAZYNA/meetings, outside Git.
# MEETINGS_STORAGE_PATH=C:/Users/your-name/AppData/Local/SAMRUK_KAZYNA/meetings

# scripts/start-backend.ps1 reuses scripts/local-ai/ai-env.ps1 and existing models.
# WHISPER_MODEL_PATH=C:/local-models/faster-whisper-large-v3
# PYANNOTE_MODEL_PATH=C:/local-models/speaker-diarization-community-1
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
FFMPEG_PATH=ffmpeg
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Optional local Unicode TTF for PDF; Windows Arial is detected automatically.
# PROTOCOL_FONT_PATH=C:/Windows/Fonts/arial.ttf
